# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# EAS config — generated by scripts/generate-eas-config.js, do not edit manually
eas.json

# Production secrets — use .env.production.template as reference
.env.production

# Simulator dev env — has localhost URLs, machine-specific
.env.development.sim

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
