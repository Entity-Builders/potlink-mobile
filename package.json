{
  "name": "potlink-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas:config": "node scripts/generate-eas-config.js",
    "build:ios": "node scripts/generate-eas-config.js && npx eas build --profile development-simulator --platform ios",
    "build:ios:device": "node scripts/generate-eas-config.js && npx eas build --profile development --platform ios",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "@eb-packages/analytics": "*",
    "@eb-packages/garden": "*",
    "@eb-packages/ui": "*",
    "expo": "~54.0.33",
    "expo-camera": "~17.0.10",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-file-system": "^19.0.21",
    "expo-image-picker": "~17.0.10",
    "expo-location": "~18.0.0",
    "expo-notifications": "~0.32.16",
    "expo-speech-recognition": "^3.1.0",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "^55.0.12",
    "posthog-react-native": "^4.36.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "^5.6.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
