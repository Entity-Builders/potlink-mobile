{
  "name": "potlink-mobile",
  "version": "1.0.7",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --lan",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas:config": "node scripts/generate-eas-config.js",
    "build:ios": "node scripts/generate-eas-config.js && npx eas build --profile development-simulator --platform ios",
    "build:ios:device": "node scripts/generate-eas-config.js && npx eas build --profile development --platform ios",
    "release": "node scripts/release.js",
    "ota:production": "node scripts/ota-production.js"
  },
  "dependencies": {
    "@eb-packages/analytics": "*",
    "@eb-packages/garden": "*",
    "@eb-packages/ui": "*",
    "@react-navigation/bottom-tabs": "^7.15.4",
    "@react-navigation/native": "^7.1.32",
    "expo": "~54.0.33",
    "expo-camera": "~17.0.10",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-file-system": "^19.0.21",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "^55.0.8",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.16",
    "expo-speech-recognition": "^3.1.0",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "posthog-react-native": "^4.36.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.24.0",
    "react-native-svg": "^15.15.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "private": true
}
